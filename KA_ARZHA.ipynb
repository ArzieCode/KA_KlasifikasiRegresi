
import pandas as pd, numpy as np
import matplotlib.pyplot as plt
from google.colab import files

from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestRegressor
from sklearn.datasets import fetch_california_housing
from sklearn.metrics import (confusion_matrix, ConfusionMatrixDisplay,
                             mean_squared_error, mean_absolute_error,
                             mean_absolute_percentage_error)

print("=" * 60)
print("BAGIAN 1 - KLASIFIKASI (Bank Marketing)")
print("=" * 60)

uploaded = files.upload()                     
df = pd.read_csv('bank-full.csv', sep=';')
print("Ukuran data:", df.shape)
print(df['y'].value_counts(), "\n")

y = (df['y'] == 'yes').astype(int)             
X = df.drop(columns=['y', 'duration'])
cat_cols = X.select_dtypes(exclude='number').columns
num_cols = X.select_dtypes(include='number').columns

pre = ColumnTransformer([
    ('cat', OneHotEncoder(handle_unknown='ignore'), cat_cols),
    ('num', StandardScaler(), num_cols)
])
clf = Pipeline([
    ('prep', pre),
    ('clf', LogisticRegression(max_iter=1000, class_weight='balanced'))
])

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42)
clf.fit(X_train, y_train)
y_pred = clf.predict(X_test)

hasil_c = X_test.copy()
hasil_c['y_aktual'] = y_test.values
hasil_c['y_prediksi'] = y_pred
print("Contoh hasil data uji:")
print(hasil_c[['age', 'job', 'balance', 'y_aktual', 'y_prediksi']].head(10), "\n")

cm = confusion_matrix(y_test, y_pred)
TN, FP, FN, TP = cm.ravel()
print("Confusion Matrix:\n", cm)
print(f"TP={TP}, TN={TN}, FP={FP}, FN={FN}\n")
ConfusionMatrixDisplay(cm, display_labels=['no', 'yes']).plot(cmap='Blues')
plt.title('Confusion Matrix - Bank Marketing'); plt.show()

accuracy     = (TP + TN) / (TP + TN + FP + FN)
sensitivity  = TP / (TP + FN)                 
specificity  = TN / (TN + FP)                 
balanced_acc = (sensitivity + specificity) / 2
precision    = TP / (TP + FP)
recall       = sensitivity
f1           = 2 * precision * recall / (precision + recall)

print(f"Accuracy          : {accuracy:.4f}")
print(f"Balanced Accuracy : {balanced_acc:.4f}")
print(f"Sensitivity       : {sensitivity:.4f}")
print(f"Specificity       : {specificity:.4f}")
print(f"Precision         : {precision:.4f}")
print(f"Recall            : {recall:.4f}")
print(f"F1-Score          : {f1:.4f}")
print(f"Akurasi baseline 'selalu no': {(y_test == 0).mean():.4f}\n")
print("=" * 60)
print("BAGIAN 2 - REGRESI (California Housing)")
print("=" * 60)

housing = fetch_california_housing(as_frame=True).frame
print("Ukuran data:", housing.shape)
print(housing.head(), "\n")

Xr = housing.drop(columns=['MedHouseVal'])
yr = housing['MedHouseVal']

Xr_train, Xr_test, yr_train, yr_test = train_test_split(
    Xr, yr, test_size=0.2, random_state=42)
reg = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1)
reg.fit(Xr_train, yr_train)
yr_pred = reg.predict(Xr_test)

hasil_r = pd.DataFrame({'Aktual': yr_test.values,
                        'Prediksi': yr_pred,
                        'Error': yr_test.values - yr_pred}).head(10)
print("Contoh hasil data uji (satuan $100.000):")
print(hasil_r.round(3), "\n")

mse   = mean_squared_error(yr_test, yr_pred)
rmse  = np.sqrt(mse)
mae   = mean_absolute_error(yr_test, yr_pred)
mape  = mean_absolute_percentage_error(yr_test, yr_pred) * 100
smape = np.mean(2 * np.abs(yr_test - yr_pred) /
                (np.abs(yr_test) + np.abs(yr_pred))) * 100

print(f"MSE   : {mse:.4f}")
print(f"RMSE  : {rmse:.4f}  (~ ${rmse * 100000:,.0f})")
print(f"MAE   : {mae:.4f}  (~ ${mae * 100000:,.0f})")
print(f"MAPE  : {mape:.2f}%")
print(f"SMAPE : {smape:.2f}%")

plt.figure(figsize=(6, 6))
plt.scatter(yr_test, yr_pred, alpha=0.3)
plt.plot([0, 5], [0, 5], 'r--')
plt.xlabel('Aktual'); plt.ylabel('Prediksi')
plt.title('Aktual vs Prediksi - California Housing'); plt.show()
